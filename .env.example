# MediHawk Frontend — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local — it contains local overrides.
#
# VITE_* variables are embedded in the production bundle and are PUBLIC.
# Never put secrets (JWT keys, database passwords, API keys) in VITE_* variables.

# ── API Configuration ──────────────────────────────────────────────────────────
# REQUIRED in production.
# Set this in Vercel: Project → Settings → Environment Variables → VITE_API_BASE_URL
# Must point to your Render backend. No trailing slash. Must use https:// in production.
#
VITE_API_BASE_URL=https://medihawk3.onrender.com

# ── Local development ──────────────────────────────────────────────────────────
# For local dev, either:
#   a) Leave VITE_API_BASE_URL unset → service falls back to http://localhost:5000
#   b) Set VITE_API_BASE_URL=http://localhost:5000 in .env.local explicitly
#
# Local dev .env.local example:
#   VITE_API_BASE_URL=http://localhost:5000
