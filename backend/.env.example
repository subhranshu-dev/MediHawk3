# MediHawk Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to source control.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  DATABASE CONFIGURATION                                                  │
# │                                                                          │
# │  DEVELOPMENT (default):                                                  │
# │    DATABASE_URL absent → SQLite file via DATABASE_PATH                   │
# │    DATABASE_URL set    → use it (PostgreSQL or other)                    │
# │                                                                          │
# │  PRODUCTION (Render):                                                    │
# │    DATABASE_URL is provided automatically by the Render PostgreSQL add-on│
# │    Startup FAILS if DATABASE_URL is absent in production.                │
# │    SQLite is NOT allowed in production.                                  │
# │                                                                          │
# │  TESTING:                                                                │
# │    Always sqlite:///:memory: — DATABASE_URL is ignored.                  │
# └─────────────────────────────────────────────────────────────────────────┘

# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development                      # development | production | testing
SECRET_KEY=CHANGE-IN-PRODUCTION            # Random secret for Flask sessions (32+ chars)
JWT_SECRET_KEY=CHANGE-IN-PRODUCTION        # Random secret for JWT signing (32+ chars)
JWT_EXPIRY_HOURS=8                         # Token lifetime in hours

# ── Database ─────────────────────────────────────────────────────────────────
# Production (Render provides this automatically):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
#
# Development override (use PostgreSQL locally):
# DATABASE_URL=postgresql://medihawk:medihawk@localhost:5432/medihawk
#
# Development default (SQLite, no DATABASE_URL needed):
# DATABASE_PATH=instance/medihawk.db

# ── PostgreSQL connection pool (production only) ──────────────────────────────
# DB_POOL_SIZE=5               # Active connections per worker
# DB_MAX_OVERFLOW=10           # Burst connections above pool_size
# DB_POOL_TIMEOUT=30           # Seconds to wait for a connection
# DB_POOL_RECYCLE=1800         # Recycle connections after 30 minutes

# ── CORS ─────────────────────────────────────────────────────────────────────
# Development:
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Production: set to your actual Vercel/frontend domain:
# CORS_ORIGINS=https://your-vercel-app.vercel.app

# ── OTP ──────────────────────────────────────────────────────────────────────
OTP_HMAC_SECRET=CHANGE-IN-PRODUCTION       # Secret key for HMAC-SHA256 OTP hashing (32+ chars)
OTP_EXPIRY_SECONDS=300                     # OTP valid for 5 minutes
OTP_MAX_ATTEMPTS=5                         # Max wrong guesses before session is consumed
OTP_RESEND_COOLDOWN_SECONDS=60             # Seconds between OTP requests
OTP_MAX_REQUESTS_PER_HOUR=10              # Max OTP requests per identifier per hour

# ── SMTP (development / local — not usable on Render FREE) ───────────────────
# Render FREE blocks all outbound SMTP ports (25, 465, 587).
# For Render FREE, use the HTTPS email section below instead.
SMTP_HOST=smtp.gmail.com                   # e.g. smtp.gmail.com
SMTP_PORT=587                              # 587 for STARTTLS
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password      # Gmail → Settings → App Passwords
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=MediHawk
SMTP_USE_TLS=true                          # true = STARTTLS (port 587)

# ── HTTPS email (Resend) — required for Render FREE deployment ────────────────
# Render FREE blocks SMTP.  Use Resend (free tier: 3 000 emails/month) via HTTPS.
#
# Setup:
#   1. Create a free account at https://resend.com
#   2. Copy your API key (starts with re_)
#   3. Verify a sender domain in the Resend dashboard (Domains → Add Domain)
#      OR use onboarding@resend.dev for sandbox testing
#      (sandbox sender only delivers to the Resend account owner's email)
#
# Required Render environment variables:
#   EMAIL_PROVIDER=https
#   RESEND_API_KEY=re_xxxxxxxxxxxx
#   EMAIL_API_FROM=noreply@yourdomain.com   (verified domain)
#
# EMAIL_PROVIDER=https                      # Use HTTPS transport (required on Render FREE)
# RESEND_API_KEY=re_xxxxxxxxxxxx            # Resend API key (get from resend.com dashboard)
# EMAIL_API_FROM=noreply@yourdomain.com     # Verified sender — Resend rejects @gmail.com
# EMAIL_API_PROVIDER=resend                 # resend (default) | sendgrid | mailgun

# ── Admin signup (controlled onboarding) ─────────────────────────────────────
# Set to a strong random value to enable admin self-registration.
# Leave empty to disable admin signup entirely.
ADMIN_INVITE_CODE=CHANGE-IN-PRODUCTION-USE-STRONG-RANDOM-VALUE

# ── Password policy ───────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_EXPIRY_MINUTES=15

# ── Application mode ─────────────────────────────────────────────────────────
APP_MODE=simulation                        # simulation | live (live enables real drone commands)

# ── Seed control ─────────────────────────────────────────────────────────────
# DEVELOPMENT (default): seed.py runs freely
# PRODUCTION: SEED_DEMO_DATA must be explicitly true to allow seeding.
# Default is false — production starts with an empty schema.
# Setting to true inserts dev users and demo drones; only use for demo deployments.
SEED_DEMO_DATA=false

# ── Gunicorn ─────────────────────────────────────────────────────────────────
# GUNICORN_WORKERS=2           # Keep low on Render free tier; raise for paid instances

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR
