# MediHawk Backend — Environment Variables
# Copy this file to .env and fill in the values. Never commit .env to source control.

# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development                      # development | production | testing
SECRET_KEY=CHANGE-IN-PRODUCTION            # Random secret for Flask sessions
JWT_SECRET_KEY=CHANGE-IN-PRODUCTION        # Random secret for JWT signing
JWT_EXPIRY_HOURS=8                         # Token lifetime in hours

# ── Database ─────────────────────────────────────────────────────────────────
# DATABASE_PATH=instance/medihawk.db       # Override default SQLite path if needed

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── OTP ──────────────────────────────────────────────────────────────────────
OTP_HMAC_SECRET=CHANGE-IN-PRODUCTION       # Secret key for HMAC-SHA256 OTP hashing
OTP_EXPIRY_SECONDS=300                     # OTP valid for 5 minutes
OTP_MAX_ATTEMPTS=5                         # Max wrong guesses before session is consumed
OTP_RESEND_COOLDOWN_SECONDS=60             # Seconds between OTP requests
OTP_MAX_REQUESTS_PER_HOUR=10              # Max OTP requests per identifier per hour

# ── SMTP (leave blank in development to disable OTP email) ───────────────────
SMTP_HOST=smtp.gmail.com                   # e.g. smtp.gmail.com or smtp.sendgrid.net
SMTP_PORT=587                              # 587 for STARTTLS, 465 for SSL
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password-or-api-key
SMTP_FROM_EMAIL=noreply@medihawk.in
SMTP_FROM_NAME=MediHawk
SMTP_USE_TLS=true                          # true = STARTTLS (port 587), false = SSL (port 465)

# ── Admin signup (controlled onboarding) ─────────────────────────────────────
# Set to a strong random value to enable admin self-registration.
# Leave empty to disable admin signup entirely.
ADMIN_INVITE_CODE=CHANGE-IN-PRODUCTION-USE-STRONG-RANDOM-VALUE

# ── Password policy ───────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_EXPIRY_MINUTES=15

# ── Application mode ─────────────────────────────────────────────────────────
APP_MODE=simulation                        # simulation | live (live enables real drone commands)

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR
